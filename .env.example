# Copy this file to .env and set your values:
#   cp .env.example .env
#
# .env is git-ignored and will never be committed.

# Stack version to deploy. Use a snapshot or a specific release, e.g.:
#   8.16.0-SNAPSHOT
#   8.16.0
STACK_VERSION=9.4.0-SNAPSHOT

# ── Elastic cluster credentials ───────────────────────────────────────────────
# Auto-populated by init-cluster.sh when run with a cluster name.
# Used by agent skills (observability-service-health, elasticsearch-esql, etc.)
# to query APM traces, logs, and metrics directly via ES|QL.
#
# Retrieve manually with:
#   oblt-cli cluster secrets credentials --cluster-name <your-cluster-name>

KIBANA_URL=https://<cluster>.kb.<region>.gcp.elastic-cloud.com:443
KIBANA_USERNAME=elastic
KIBANA_PASSWORD=
KIBANA_API_KEY=

ELASTICSEARCH_URL=https://<cluster>.es.<region>.gcp.elastic-cloud.com:443
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
